// =====================================================================
// LESHIPAI — custom layer
// Compiled to /css/custom.css and linked AFTER the theme stylesheet.
//
// Palette: "midnight aurora".
//   Base      #0A0E14  (deep ink-blue — pulled straight from the uploaded swatch)
//   Surfaces  #0F151E / #131B26 / #18222F  (layered elevation)
//   Aurora    #58E1D2  (aqua)  →  #8E86FF  (periwinkle)
//   Warmth    #F7BE8A  (peach, used sparingly for code)
//
// Every colour below is a token, so dark and light share one set of rules
// and only the token blocks differ.
// =====================================================================

// ---------- 0. Custom font: The Witches ---------------------------

@font-face
  font-family: 'TheWitches'
  src: url('/fonts/TheWitches.ttf') format('truetype')
  font-weight: normal
  font-style: normal
  font-display: swap

// ---------- 1. Design tokens ---------------------------------------

// Always hide the FPS counter
#fps-box
  display: none !important

[data-theme='dark']
  // Canvas + surfaces
  --global-bg: #0A0E14
  --card-bg: #0F151E
  --sidebar-bg: #0F151E
  --sidebar-menu-bg: #131B26
  --search-bg: #0C121B
  --search-input-color: rgba(230, 236, 247, 0.86)
  --search-a-color: rgba(230, 236, 247, 0.86)
  --preloader-bg: #0A0E14
  --preloader-color: rgba(230, 236, 247, 0.8)
  --zoom-bg: #0A0E14
  --timeline-bg: #131B26
  --footer-bg: #080B10

  // Text
  --font-color: rgba(230, 236, 247, 0.86)
  --text-highlight-color: #EAF1FB
  --card-meta: #7E93B0
  --white: rgba(234, 241, 251, 0.95)
  --light-grey: rgba(230, 236, 247, 0.6)
  --dark-grey: rgba(230, 236, 247, 0.14)

  // Hairlines
  --hairline: rgba(140, 172, 220, 0.12)
  --hairline-strong: rgba(140, 172, 220, 0.3)

  // Accents
  --accent: #58E1D2
  --accent-soft: #7FF0E3
  --accent-2: #8E86FF
  --accent-2-soft: #B0AAFF
  --peach: #F7BE8A
  --accent-grad: linear-gradient(120deg, #58E1D2 0%, #8E86FF 100%)
  --name-grad: linear-gradient(100deg, #EAF1FB 0%, #B0AAFF 58%, #58E1D2 100%)

  // Rules / quotes / buttons
  --hr-border: rgba(140, 172, 220, 0.22)
  --hr-before-color: rgba(88, 225, 210, 0.65)
  --blockquote-color: rgba(214, 222, 240, 0.82)
  --blockquote-bg: rgba(88, 225, 210, 0.05)
  --btn-bg: #131B26
  --btn-color: rgba(230, 236, 247, 0.85)
  --btn-hover-color: #58E1D2
  --toc-link-color: rgba(160, 178, 205, 0.85)
  --mark-bg: rgba(10, 14, 20, 0.6)
  --text-bg-hover: rgba(88, 225, 210, 0.14)

  // Chrome that stays dark in both themes (code, control panel)
  --panel-bg: linear-gradient(180deg, rgba(19, 27, 38, 0.98), rgba(10, 14, 20, 0.98))
  --panel-border: rgba(88, 225, 210, 0.16)

  // Code blocks (theme highlight tokens)
  --hl-bg: #0B111A
  --hl-color: rgba(230, 236, 247, 0.88)
  --hltools-bg: #0E141F
  --hlnumber-bg: #0E141F
  --hlscrollbar-bg: rgba(88, 225, 210, 0.28)
  --hlexpand-bg: linear-gradient(180deg, rgba(11, 17, 26, 0.6), rgba(11, 17, 26, 0.92))

  // Depth
  --card-box-shadow: 0 10px 30px rgba(2, 5, 10, 0.5), 0 1px 0 rgba(255, 255, 255, 0.04)
  --card-hover-box-shadow: 0 16px 44px rgba(2, 5, 10, 0.62), 0 0 0 1px rgba(88, 225, 210, 0.26), 0 0 34px rgba(88, 225, 210, 0.08)
  --scrollbar-color: rgba(120, 150, 200, 0.3)
  --void-glow: 0 0 30px rgba(88, 225, 210, 0.16)
  --void-glow-strong: 0 0 46px rgba(142, 134, 255, 0.22)

[data-theme='light']
  // Canvas + surfaces
  --global-bg: #F3F6FB
  --card-bg: #FFFFFF
  --sidebar-bg: #FFFFFF
  --sidebar-menu-bg: #EEF3FB
  --search-bg: #EAF0F8
  --search-input-color: rgba(24, 36, 54, 0.85)
  --search-a-color: rgba(24, 36, 54, 0.85)
  --preloader-bg: #F3F6FB
  --preloader-color: rgba(24, 36, 54, 0.8)
  --zoom-bg: #F3F6FB
  --timeline-bg: #EEF3FB
  --footer-bg: #EEF2F8

  // Text
  --font-color: rgba(24, 36, 54, 0.88)
  --text-highlight-color: #10203A
  --card-meta: #5F7595
  --white: rgba(16, 32, 58, 0.95)
  --light-grey: rgba(24, 36, 54, 0.55)
  --dark-grey: rgba(24, 36, 54, 0.12)

  // Hairlines
  --hairline: rgba(30, 60, 110, 0.12)
  --hairline-strong: rgba(30, 60, 110, 0.28)

  // Accents (darkened for contrast on paper)
  --accent: #0E9E93
  --accent-soft: #0B8A80
  --accent-2: #5B52CF
  --accent-2-soft: #4A41C0
  --peach: #B06F26
  --accent-grad: linear-gradient(120deg, #0E9E93 0%, #5B52CF 100%)
  --name-grad: linear-gradient(100deg, #10203A 0%, #5B52CF 58%, #0E9E93 100%)

  // Rules / quotes / buttons
  --hr-border: rgba(30, 60, 110, 0.2)
  --hr-before-color: rgba(14, 158, 147, 0.65)
  --blockquote-color: rgba(40, 55, 80, 0.82)
  --blockquote-bg: rgba(14, 158, 147, 0.06)
  --btn-bg: #EEF3FB
  --btn-color: rgba(24, 36, 54, 0.85)
  --btn-hover-color: #0E9E93
  --toc-link-color: rgba(60, 80, 110, 0.8)
  --mark-bg: rgba(243, 246, 251, 0.6)
  --text-bg-hover: rgba(14, 158, 147, 0.16)

  // Chrome that stays dark in both themes (code, control panel)
  --panel-bg: linear-gradient(180deg, rgba(19, 27, 38, 0.98), rgba(10, 14, 20, 0.98))
  --panel-border: rgba(88, 225, 210, 0.16)

  // Code blocks (theme highlight tokens)
  --hl-bg: #F6F8FC
  --hl-color: rgba(24, 36, 54, 0.9)
  --hltools-bg: #EEF2F8
  --hlnumber-bg: #EEF2F8
  --hlscrollbar-bg: rgba(14, 158, 147, 0.3)
  --hlexpand-bg: linear-gradient(180deg, rgba(246, 248, 252, 0.6), rgba(246, 248, 252, 0.92))

  // Depth
  --card-box-shadow: 0 6px 22px rgba(30, 60, 110, 0.09)
  --card-hover-box-shadow: 0 12px 34px rgba(30, 60, 110, 0.16), 0 0 0 1px rgba(14, 158, 147, 0.22)
  --scrollbar-color: rgba(45, 120, 160, 0.28)
  --void-glow: 0 0 30px rgba(14, 158, 147, 0.16)
  --void-glow-strong: 0 0 46px rgba(91, 82, 207, 0.2)

// ---------- 2. Global body + aurora backdrop -----------------------

body
  background-color: var(--global-bg)
  font-family: 'Inter', 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif

// Aurora field — three slow light wells behind everything.
body::before
  content: ''
  position: fixed
  top: 0
  left: 0
  width: 100%
  height: 100%
  pointer-events: none
  z-index: -1
  background: radial-gradient(60% 48% at 12% -4%, rgba(88, 225, 210, 0.12), transparent 62%), radial-gradient(54% 44% at 88% 4%, rgba(142, 134, 255, 0.12), transparent 64%), radial-gradient(80% 60% at 50% 112%, rgba(46, 92, 168, 0.16), transparent 68%)

// Film grain, very subtle, over the whole viewport.
body::after
  content: ''
  position: fixed
  top: 0
  left: 0
  width: 100%
  height: 100%
  pointer-events: none
  z-index: 0
  opacity: 0.03
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E")
  background-size: 200px 200px

[data-theme='light'] body::before
  background: radial-gradient(60% 48% at 12% -4%, rgba(14, 158, 147, 0.1), transparent 62%), radial-gradient(54% 44% at 88% 4%, rgba(91, 82, 207, 0.1), transparent 64%)

[data-theme='light'] body::after
  opacity: 0

// Tint the photographic site background toward ink (instead of pure black)
[data-theme='dark'] #web_bg:before
  background: linear-gradient(180deg, rgba(10, 14, 20, 0.72), rgba(10, 14, 20, 0.86))

// ---------- 3. Navigation (nav bar) --------------------------------

#nav
  background: transparent !important
  backdrop-filter: none !important
  -webkit-backdrop-filter: none !important
  border-bottom: none !important
  box-shadow: none !important

// In light mode the bar always carries a translucent sheet so the dark
// menu text stays readable over the photographic header.
[data-theme='light'] #nav
  background: rgba(243, 246, 251, 0.82) !important
  backdrop-filter: blur(18px) saturate(1.2) !important
  -webkit-backdrop-filter: blur(18px) saturate(1.2) !important
  border-bottom: 1px solid var(--hairline) !important

// Keep nav readable when scrolled over content (non-hero pages)
.nav-fixed #nav
  background: var(--sidebar-bg) !important
  backdrop-filter: blur(18px) saturate(1.3) !important
  -webkit-backdrop-filter: blur(18px) saturate(1.3) !important
  border-bottom: 1px solid var(--hairline) !important
  box-shadow: 0 6px 30px rgba(2, 5, 10, 0.35) !important

#blog-info
  .site-name
    font-family: 'TheWitches', 'Outfit', sans-serif
    font-weight: normal
    letter-spacing: 0.06em
    font-size: 1.3rem
    color: var(--text-highlight-color)
    background: var(--name-grad)
    -webkit-background-clip: text
    background-clip: text
    -webkit-text-fill-color: transparent
    transition: filter 0.3s ease

  .site-name:hover
    filter: brightness(1.25) drop-shadow(0 0 14px rgba(88, 225, 210, 0.45))

// Nav menu items — The Witches
#menus .site-page,
#menus .site-page span,
#sidebar-menus .site-page,
#sidebar-menus .site-page span
  font-family: 'TheWitches', 'Outfit', sans-serif
  letter-spacing: 0.05em

// Nav buttons hover
.nav-button a:hover,
#menus .site-page:hover
  color: var(--accent)

// ---------- 4. Hero / Cover banner ---------------------------------

#page-header
  position: relative

#page-header.full_page
  background-color: var(--global-bg)

// The cover image rendered as a cinematic banner
#post-cover
  object-fit: cover
  object-position: center 20%
  filter: brightness(0.62) saturate(0.72)

// Overlay gradient — ink fades in at the bottom
#page-header::after
  content: ''
  position: absolute
  bottom: 0
  left: 0
  right: 0
  height: 62%
  background: linear-gradient(to bottom, transparent, rgba(10, 14, 20, 0.96))
  pointer-events: none

// Site title in hero
#site-title
  font-family: 'TheWitches', 'Outfit', sans-serif
  font-weight: normal
  font-size: clamp(2.8rem, 6vw, 5rem)
  letter-spacing: 0.18em
  color: #EAF1FB
  text-shadow: 0 0 60px rgba(88, 225, 210, 0.28), 0 0 120px rgba(142, 134, 255, 0.2), 0 2px 20px rgba(0, 0, 0, 0.7)

#site-subtitle #subtitle
  font-family: 'TheWitches', 'Outfit', sans-serif
  font-weight: normal
  font-size: 1.05rem
  letter-spacing: 0.25em
  color: rgba(200, 232, 245, 0.85)
  text-transform: lowercase

// Scroll-down chevron
#scroll-down .scroll-down-effects
  color: rgba(88, 225, 210, 0.6)
  animation: void-pulse 2.5s ease-in-out infinite

@keyframes void-pulse
  0%, 100%
    opacity: 0.4
    transform: translateY(0)
  50%
    opacity: 0.9
    transform: translateY(6px)

// ---------- 5. Cards (posts, sidebar) ------------------------------

.card-widget,
.recent-post-item
  position: relative
  background: var(--card-bg)
  border: 1px solid var(--hairline)
  box-shadow: var(--card-box-shadow)
  border-radius: 18px
  transition: box-shadow 0.35s ease, border-color 0.35s ease, transform 0.35s ease

// Aurora hairline along the top edge of every card.
.card-widget::before,
.recent-post-item::before
  content: ''
  position: absolute
  top: 0
  left: 18px
  right: 18px
  height: 1px
  border-radius: 1px
  background: linear-gradient(90deg, transparent, rgba(88, 225, 210, 0.5), rgba(142, 134, 255, 0.5), transparent)
  opacity: 0.5
  transition: opacity 0.35s ease

.card-widget:hover,
.recent-post-item:hover
  box-shadow: var(--card-hover-box-shadow)
  border-color: var(--hairline-strong)
  transform: translateY(-3px)

.card-widget:hover::before,
.recent-post-item:hover::before
  opacity: 1

// Card header divider
.card-widget .item-headline
  border-bottom: 1px solid var(--hairline)
  padding-bottom: 10px
  margin-bottom: 14px

// Sidebar card header icons
.card-widget .item-headline i
  color: var(--accent)
  text-shadow: 0 0 14px rgba(88, 225, 210, 0.45)

// ---------- 6. Post list cards -------------------------------------

// Post card image hover
.recent-post-item .post_cover img
  transition: transform 0.6s ease, filter 0.6s ease
  filter: brightness(0.95) saturate(0.85)

.recent-post-item:hover .post_cover img
  transform: scale(1.05)
  filter: brightness(1.05) saturate(1.05)

// Post title link
.recent-post-item .article-title
  font-family: 'Outfit', sans-serif
  font-weight: 500
  font-size: 1.05rem
  color: var(--text-highlight-color)
  transition: color 0.25s

.recent-post-item:hover .article-title
  color: var(--accent)

// Excerpt text
.recent-post-item .content
  color: var(--light-grey)
  font-size: 0.88rem
  line-height: 1.72

// Category badge
.article-meta__categories
  background: rgba(88, 225, 210, 0.1)
  color: var(--accent)
  border: 1px solid rgba(88, 225, 210, 0.26)
  border-radius: 999px
  padding: 2px 12px
  font-size: 0.78rem
  font-weight: 500
  transition: background 0.25s, color 0.25s, border-color 0.25s

.article-meta__categories:hover
  background: rgba(142, 134, 255, 0.18)
  border-color: rgba(142, 134, 255, 0.5)
  color: var(--accent-2)

// Tag pills
.article-meta__tags
  color: var(--card-meta)
  font-size: 0.8rem
  transition: color 0.2s

.article-meta__tags::before
  content: '#'
  color: rgba(88, 225, 210, 0.7)

.article-meta__tags:hover
  color: var(--accent)

// Meta (date, icons)
.article-meta-time
  color: var(--card-meta)
  font-size: 0.8rem

.article-meta-time i
  color: rgba(88, 225, 210, 0.7)

// ---------- 7. Sidebar author card ---------------------------------

#aside-content .card-author .author-avatar
  border: 2px solid rgba(88, 225, 210, 0.35)
  box-shadow: 0 0 22px rgba(88, 225, 210, 0.16)
  transition: box-shadow 0.4s ease, border-color 0.4s ease

#aside-content .card-author .author-avatar:hover
  border-color: rgba(142, 134, 255, 0.75)
  box-shadow: 0 0 44px rgba(142, 134, 255, 0.34)

// Author name
#aside-content .card-author .author-name a
  font-family: 'Outfit', sans-serif
  font-weight: 600
  color: var(--text-highlight-color)

// Author description
#aside-content .card-author .author-info-description
  color: var(--card-meta)
  font-size: 0.85rem
  line-height: 1.6

// Follow button
#aside-content .card-author .author-button-box a
  background: rgba(88, 225, 210, 0.12)
  border: 1px solid rgba(88, 225, 210, 0.3)
  color: var(--accent)
  border-radius: 999px
  padding: 6px 18px
  font-size: 0.85rem
  transition: all 0.25s

#aside-content .card-author .author-button-box a:hover
  background: rgba(142, 134, 255, 0.18)
  border-color: rgba(142, 134, 255, 0.6)
  color: var(--accent-2)
  box-shadow: 0 0 24px rgba(142, 134, 255, 0.28)

// Announcement card
#aside-content .card-announcement .announcement-content
  color: var(--card-meta)
  font-size: 0.87rem
  line-height: 1.65

// ---------- 8. Homepage category bar -------------------------------

#category-bar
  position: relative
  overflow: hidden
  margin: 0 0 18px

  &::after
    position: absolute
    top: 0
    right: 0
    bottom: 0
    width: 36px
    background: linear-gradient(to right, rgba(10, 14, 20, 0), var(--global-bg))
    content: ''
    opacity: 0
    pointer-events: none
    transition: opacity .3s

  &.has-overflow::after
    opacity: 1

  .category-bar-items
    display: flex
    gap: 8px
    overflow-x: auto
    padding: 2px 36px 6px 2px
    scrollbar-width: none
    scroll-behavior: smooth

    &::-webkit-scrollbar
      display: none

  .category-bar-item
    flex: 0 0 auto

    a
      display: inline-block
      padding: 5px 16px
      border: 1px solid rgba(88, 225, 210, 0.2)
      border-radius: 999px
      background: var(--card-bg)
      color: var(--card-meta)
      font-size: 0.88em
      font-weight: 400
      line-height: 1.6
      transition: all .25s ease

      &:hover
        border-color: var(--accent)
        color: var(--accent)
        background: rgba(88, 225, 210, 0.1)

    &.is-active a
      border-color: transparent
      background: linear-gradient(120deg, rgba(88, 225, 210, 0.22), rgba(142, 134, 255, 0.22))
      color: var(--text-highlight-color)
      box-shadow: 0 0 18px rgba(88, 225, 210, 0.14)

#recent-posts .category-bar-empty
  padding: 28px 4px
  color: var(--card-meta)
  font-size: .92em
  text-align: center

// ---------- 9. Sidebar cards: calendar + schedule ------------------

#card-widget-calendar,
#card-widget-schedule
  .item-content
    display: flex
    gap: 14px

  #calendar-area-left,
  #schedule-area-left
    flex: 0 0 40%

  #calendar-area-right,
  #schedule-area-right
    flex: 1
    min-width: 0

#card-widget-calendar
  #calendar-week
    color: var(--card-meta)
    font-size: .85em

  #calendar-date
    margin: 2px 0
    color: var(--accent)
    font-size: 52px
    font-weight: 700
    line-height: 1.1
    text-shadow: 0 0 24px rgba(88, 225, 210, 0.55)

  #calendar-solar,
  #calendar-month
    color: var(--card-meta)
    font-size: .82em
    line-height: 1.7

  #calendar-main
    font-size: .8em
    text-align: center

    .calendar-rh a
      color: var(--card-meta)

    .calendar-d0 a
      color: var(--peach)

    .calendar-d6 a
      color: var(--accent-2)

    .calendar-d0,
    .calendar-d1,
    .calendar-d2,
    .calendar-d3,
    .calendar-d4,
    .calendar-d5,
    .calendar-d6
      display: inline-block
      width: 14.28%
      line-height: 1.9

    a
      color: var(--font-color)
      text-decoration: none

      &.now
        border-radius: 6px
        background: linear-gradient(120deg, #2FAE9F, #6D63E0)
        color: #EAF1FB
        box-shadow: 0 0 14px rgba(88, 225, 210, 0.5)

#card-widget-schedule
  #schedule-title
    color: var(--card-meta)
    font-size: .85em

  #schedule-days
    margin: 2px 0
    color: var(--accent)
    font-size: 44px
    font-weight: 700
    line-height: 1.2
    text-shadow: 0 0 24px rgba(88, 225, 210, 0.55)

  #schedule-date
    color: var(--card-meta)
    font-size: .82em

  .schedule-r0,
  .schedule-r1,
  .schedule-r2
    display: flex
    align-items: center
    gap: 8px
    margin: 6px 0

  .schedule-d0
    flex: 0 0 2.6em
    color: var(--card-meta)
    font-size: .82em

  .schedule-d1
    flex: 1
    min-width: 0

  .aside-span1,
  .aside-span2
    display: inline-block
    width: 50%
    color: var(--font-color)
    font-size: .78em
    text-align: left

  .aside-span2
    text-align: right

  progress
    display: block
    width: 100%
    height: 5px
    border: none
    border-radius: 6px
    background: var(--dark-grey)
    appearance: none
    -webkit-appearance: none
    overflow: hidden

    &::-webkit-progress-bar
      border-radius: 6px
      background: var(--dark-grey)

    &::-webkit-progress-value
      border-radius: 6px
      background: var(--accent-grad)

    &::-moz-progress-bar
      border-radius: 6px
      background: var(--accent-grad)

// ---------- 10. Control center panel --------------------------------

#console-switch
  display: inline
  padding: 0 0 0 14px
  cursor: pointer
  vertical-align: middle

  .site-page
    transition: color .3s

    &:hover
      color: var(--accent)

#console-mask
  position: fixed
  top: 0
  right: 0
  bottom: 0
  left: 0
  z-index: 105
  background: rgba(2, 5, 10, 0.62)
  backdrop-filter: blur(4px)
  opacity: 0
  visibility: hidden
  transition: opacity .3s, visibility .3s

  &.show
    opacity: 1
    visibility: visible

#console
  position: fixed
  top: 0
  right: 0
  bottom: 0
  z-index: 110
  width: 320px
  max-width: 86vw
  transform: translateX(105%)
  transition: transform .35s cubic-bezier(.22, 1, .36, 1)

  &.show
    transform: translateX(0)

  .console-mainbox
    display: flex
    flex-direction: column
    height: 100%
    border-left: 1px solid var(--panel-border)
    background: var(--panel-bg)
    backdrop-filter: blur(18px)
    box-shadow: -10px 0 46px rgba(2, 5, 10, 0.7), -1px 0 0 rgba(88, 225, 210, 0.1)
    color: rgba(230, 236, 247, 0.86)

  .console-header
    display: flex
    align-items: center
    justify-content: space-between
    padding: 18px 20px 12px

  .console-title
    color: #EAF1FB
    font-size: 1.1em
    font-weight: 600
    font-family: 'Outfit', sans-serif

    i
      margin-right: 8px
      color: #58E1D2

  .console-close
    padding: 4px 8px
    color: rgba(160, 178, 205, 0.85)
    cursor: pointer
    transition: color .25s

    &:hover
      color: #F7BE8A

  .console-body
    flex: 1
    overflow-y: auto
    padding: 4px 20px 24px

  .console-group
    margin-bottom: 18px
    padding-bottom: 16px
    border-bottom: 1px dashed rgba(140, 172, 220, 0.14)

    &:last-child
      border-bottom: none

  .console-group-title
    margin-bottom: 10px
    color: rgba(160, 178, 205, 0.85)
    font-size: .85em
    letter-spacing: .08em
    text-transform: uppercase

  .console-btn-group
    display: flex
    gap: 8px

  .console-btn
    flex: 1
    padding: 7px 0
    border: 1px solid rgba(88, 225, 210, 0.2)
    border-radius: 10px
    background: transparent
    color: rgba(230, 236, 247, 0.86)
    font-size: .88em
    cursor: pointer
    transition: all .25s

    &:hover
      border-color: #58E1D2
      color: #58E1D2
      background: rgba(88, 225, 210, 0.07)

    &.is-active
      border-color: transparent
      background: linear-gradient(120deg, rgba(88, 225, 210, 0.2), rgba(142, 134, 255, 0.2))
      color: #EAF1FB

  .console-switch
    display: flex
    align-items: center
    justify-content: space-between
    padding: 8px 0
    color: rgba(230, 236, 247, 0.86)
    font-size: .9em
    cursor: pointer

    i
      position: relative
      width: 36px
      height: 20px
      border-radius: 20px
      background: rgba(140, 172, 220, 0.2)
      transition: background .25s

      &::after
        position: absolute
        top: 2px
        left: 2px
        width: 16px
        height: 16px
        border-radius: 50%
        background: #7a8aa8
        content: ''
        transition: transform .25s, background .25s

    &.is-active i
      background: linear-gradient(120deg, #2FAE9F, #6D63E0)

      &::after
        transform: translateX(16px)
        background: #EAF1FB

  .console-about
    margin: 0
    padding: 0
    list-style: none

    li
      display: flex
      align-items: center
      justify-content: space-between
      padding: 5px 0
      color: rgba(160, 178, 205, 0.85)
      font-size: .85em

      span:last-child
        color: rgba(230, 236, 247, 0.86)

// ---------- 11. FPS chip --------------------------------------------

#fps-box
  position: fixed
  bottom: 14px
  left: 14px
  z-index: 90
  display: flex
  gap: 6px
  padding: 4px 10px
  border: 1px solid rgba(88, 225, 210, 0.18)
  border-radius: 8px
  background: rgba(10, 14, 20, 0.9)
  backdrop-filter: blur(10px)
  box-shadow: var(--card-box-shadow)
  color: rgba(160, 178, 205, 0.85)
  font-family: 'Fira Code', Consolas, Menlo, Monaco, 'Courier New', monospace
  font-size: 12px
  line-height: 1.6
  pointer-events: none

  .fps-text
    min-width: 2ch
    color: #58E1D2

  @media (max-width: 768px)
    display: none !important

// ---------- 12. Footer ----------------------------------------------

#footer
  background-color: var(--footer-bg)
  border-top: 1px solid var(--hairline)

  &:before
    display: none

  .footer-other
    display: flex
    flex-wrap: wrap
    align-items: center
    justify-content: space-between
    gap: 8px 16px
    padding: 18px 24px
    max-width: 1200px
    margin: 0 auto
    text-align: left

    .footer-copyright
      text-align: left
      color: var(--card-meta)
      font-size: 0.82em

    @media (max-width: 768px)
      justify-content: center
      text-align: center

      .footer-copyright
        text-align: center

#count-time
  color: var(--card-meta)
  font-family: 'Fira Code', Consolas, Menlo, Monaco, 'Courier New', monospace
  font-size: .85em
  white-space: nowrap

  b
    color: var(--accent)
    font-weight: 600

// ---------- 13. Post / article page ---------------------------------

#post
  .post-title
    font-family: 'Outfit', sans-serif
    font-weight: 500
    color: var(--text-highlight-color)
    letter-spacing: 0.02em

  #article-container
    font-family: 'Inter', sans-serif
    line-height: 1.8
    color: var(--font-color)

  // Headings
  #article-container h1,
  #article-container h2,
  #article-container h3,
  #article-container h4
    font-family: 'Outfit', sans-serif
    font-weight: 600
    color: var(--text-highlight-color)
    border-bottom: none

  #article-container h2
    border-left: 3px solid transparent
    border-image: var(--accent-grad) 1
    padding-left: 12px
    margin-left: -15px

  // Blockquotes
  #article-container blockquote
    border-left: 3px solid transparent
    border-image: var(--accent-grad) 1
    background: var(--blockquote-bg)
    color: var(--blockquote-color)
    border-radius: 0 10px 10px 0
    padding: 12px 16px
    font-style: italic

  // Inline code
  #article-container code:not([class])
    background: rgba(247, 190, 138, 0.1)
    color: var(--peach)
    border: 1px solid rgba(247, 190, 138, 0.16)
    border-radius: 5px
    padding: 1px 6px
    font-family: 'Fira Code', Consolas, monospace
    font-size: 0.87em

  // Links
  #article-container a
    color: var(--accent-2)
    text-decoration-color: rgba(142, 134, 255, 0.35)
    transition: color 0.2s, text-decoration-color 0.2s

    &:hover
      color: var(--accent)
      text-decoration-color: rgba(88, 225, 210, 0.6)

  // Inline media & tables
  #article-container img
    border-radius: 12px
    box-shadow: var(--card-box-shadow)

  #article-container table
    border-color: var(--hairline)

    th
      background: rgba(88, 225, 210, 0.08)

// ---------- 14. Code block (highlight) ------------------------------

figure.highlight
  border: 1px solid var(--hairline)
  border-radius: 12px
  overflow: hidden

  .highlight-tools
    border-bottom: 1px solid rgba(140, 172, 220, 0.1)

  .code-lang
    color: var(--accent)
    font-size: 0.78em

  // Scrollbar in code blocks
  pre
    &::-webkit-scrollbar
      height: 4px

    &::-webkit-scrollbar-track
      background: transparent

    &::-webkit-scrollbar-thumb
      background: var(--hlscrollbar-bg)
      border-radius: 4px

// ---------- 15. TOC (table of contents) ----------------------------

#toc-div
  .toc-content
    .toc-link
      color: var(--card-meta)
      transition: color 0.2s, border-color 0.2s

      &.active-class
        color: var(--accent)
        border-left-color: var(--accent)

      &:hover
        color: var(--accent-2)

// ---------- 16. Tags page ------------------------------------------

#tag-cloud-list a
  border: 1px solid rgba(88, 225, 210, 0.16)
  background: var(--card-bg)
  color: var(--font-color)
  border-radius: 999px
  padding: 4px 14px
  transition: all 0.25s

  &:hover
    border-color: var(--accent)
    color: var(--accent)
    background: rgba(88, 225, 210, 0.08)
    box-shadow: 0 0 18px rgba(88, 225, 210, 0.16)

// ---------- 17. Scrollbar ------------------------------------------

::-webkit-scrollbar
  width: 6px

::-webkit-scrollbar-track
  background: transparent

::-webkit-scrollbar-thumb
  background: linear-gradient(180deg, rgba(88, 225, 210, 0.4), rgba(142, 134, 255, 0.4))
  border-radius: 6px

  &:hover
    background: linear-gradient(180deg, rgba(88, 225, 210, 0.7), rgba(142, 134, 255, 0.7))

// ---------- 18. Pagination + rightside controls --------------------

#pagination
  .pagination-button
    border: 1px solid rgba(88, 225, 210, 0.2)
    background: var(--card-bg)
    color: var(--font-color)
    border-radius: 999px
    transition: all 0.25s

    &:hover
      border-color: var(--accent)
      color: var(--accent)
      background: rgba(88, 225, 210, 0.08)

  .page-number.current
    border: 1px solid transparent
    background: linear-gradient(120deg, rgba(88, 225, 210, 0.24), rgba(142, 134, 255, 0.24))
    color: var(--text-highlight-color)
    border-radius: 999px

#rightside
  button,
  a
    background: var(--card-bg)
    color: var(--card-meta)
    border: 1px solid var(--hairline)
    backdrop-filter: blur(10px)
    transition: all 0.25s

    &:hover
      border-color: rgba(88, 225, 210, 0.55)
      color: var(--accent)

  #go-up
    background: linear-gradient(135deg, rgba(88, 225, 210, 0.2), rgba(142, 134, 255, 0.2))
    color: var(--text-highlight-color)

// ---------- 19. Runtime toggles driven by the control center -------

@media (min-width: 900px)
  html.aside-left
    .layout > div:first-child
      order: 2

    #aside-content
      padding-left: 0
      padding-right: 15px

html.font-large
  --global-font-size: 16.5px

html.hide-fps
  #fps-box
    display: none

html.hide-scroll-percent
  #go-up .scroll-percent
    display: none

// ---------- 20. Smooth corners (Houdini paint worklet) ------------

#console .console-mainbox
  border-radius: 30px
  mask-image: paint(smooth-corners)
  -webkit-mask-image: paint(smooth-corners)
  --smooth-level: 30

#fps-box
  mask-image: paint(smooth-corners)
  -webkit-mask-image: paint(smooth-corners)
  --smooth-level: 8

figure.highlight
  mask-image: paint(smooth-corners)
  -webkit-mask-image: paint(smooth-corners)
  --smooth-level: 14

// ---------- 21. Micro-animations -----------------------------------

// Fade-in cards on load
@keyframes void-rise
  from
    opacity: 0
    transform: translateY(14px)
  to
    opacity: 1
    transform: translateY(0)

.card-widget,
.recent-post-item
  animation: void-rise 0.5s ease both

// Stagger post cards
.recent-post-item:nth-child(1) { animation-delay: 0.05s }
.recent-post-item:nth-child(2) { animation-delay: 0.12s }
.recent-post-item:nth-child(3) { animation-delay: 0.19s }
.recent-post-item:nth-child(4) { animation-delay: 0.26s }
.recent-post-item:nth-child(5) { animation-delay: 0.33s }

// Sidebar cards stagger
.card-widget:nth-child(1) { animation-delay: 0.08s }
.card-widget:nth-child(2) { animation-delay: 0.16s }
.card-widget:nth-child(3) { animation-delay: 0.24s }
.card-widget:nth-child(4) { animation-delay: 0.32s }
.card-widget:nth-child(5) { animation-delay: 0.40s }

// ---------- 22. Selection highlight --------------------------------

::selection
  background: rgba(88, 225, 210, 0.32)
  color: #EAF1FB

::-moz-selection
  background: rgba(88, 225, 210, 0.32)
  color: #EAF1FB

// ---------- 23. Mobile tweaks --------------------------------------

@media (max-width: 768px)
  #site-title
    font-size: 2rem
    letter-spacing: 0.08em

  .card-widget,
  .recent-post-item
    border-radius: 14px

// ---------- 24. Avatar glow in sidebar author card -----------------

.avatar-img img,
#aside-content .author-avatar img
  border-radius: 50%
  border: 2px solid rgba(88, 225, 210, 0.3)
  box-shadow: 0 0 25px rgba(88, 225, 210, 0.14)
  transition: box-shadow 0.4s, border-color 0.4s

.avatar-img:hover img,
#aside-content .author-avatar:hover img
  box-shadow: 0 0 46px rgba(142, 134, 255, 0.32)
  border-color: rgba(142, 134, 255, 0.7)

// ---------- 25. Live2D widget ---------------------------------------

// waifu.css is injected at runtime, i.e. after custom.css, so these rules
// need higher specificity than #waifu / #live2d to win.
html body #waifu
  left: auto
  right: 0
  z-index: 95

html body #waifu #live2d
  width: 260px
  height: 260px

// No speech bubble and no toolbar: everything is disabled in
// /live2d/waifu-tips.json and autoload.js, the nodes are removed too.
html body #waifu #waifu-tips,
html body #waifu #waifu-tool
  display: none

@media (max-width: 768px)
  html body #waifu
    #live2d
      width: 200px
      height: 200px

// ---------- 26. About page -------------------------------------------

#page #article-container
  .ah
    position: relative
    display: flex
    align-items: center
    gap: 26px
    padding: 34px 32px
    border: 1px solid var(--hairline)
    border-radius: 18px
    background: linear-gradient(135deg, var(--card-bg), rgba(88, 225, 210, 0.05))
    box-shadow: var(--card-box-shadow)
    overflow: hidden

    &::before
      content: ''
      position: absolute
      top: 0
      left: 22px
      right: 22px
      height: 1px
      background: linear-gradient(90deg, transparent, rgba(88, 225, 210, 0.6), rgba(142, 134, 255, 0.6), transparent)

    .ah-avatar
      flex: 0 0 auto

      img
        width: 104px
        height: 104px
        object-fit: cover
        border-radius: 50%
        border: 2px solid rgba(88, 225, 210, 0.4)
        box-shadow: 0 0 36px rgba(88, 225, 210, 0.2)

    .ah-id
      min-width: 0

    .ah-name
      font-family: 'TheWitches', 'Outfit', sans-serif
      font-size: clamp(2rem, 5vw, 2.9rem)
      font-weight: normal
      letter-spacing: 0.1em
      line-height: 1.1
      color: var(--text-highlight-color)
      text-shadow: 0 0 34px rgba(88, 225, 210, 0.25)

    .ah-tag
      margin-top: 8px
      font-family: 'Inter', sans-serif
      font-size: 0.76rem
      letter-spacing: 0.22em
      text-transform: uppercase
      color: var(--card-meta)

    .ah-links
      display: flex
      flex-wrap: wrap
      gap: 10px
      margin-top: 18px

      a,
      .ah-discord
        display: inline-flex
        align-items: center
        gap: 8px
        padding: 7px 14px
        font-family: 'Inter', sans-serif
        font-size: 0.82rem
        color: var(--font-color)
        text-decoration: none
        border: 1px solid rgba(88, 225, 210, 0.25)
        border-radius: 999px
        background: rgba(88, 225, 210, 0.08)
        transition: color 0.2s, border-color 0.2s, background 0.2s, box-shadow 0.2s

      a:hover
        color: var(--text-highlight-color)
        border-color: rgba(142, 134, 255, 0.65)
        background: rgba(142, 134, 255, 0.18)
        box-shadow: 0 0 20px rgba(142, 134, 255, 0.3)

      .ah-discord
        color: var(--card-meta)
        cursor: default

  .ah-focus
    margin-top: 30px

    .ah-h
      font-family: 'TheWitches', 'Outfit', sans-serif
      font-size: 1.7rem
      font-weight: normal
      letter-spacing: 0.08em
      color: var(--text-highlight-color)
      border-bottom: none
      padding-bottom: 0

    .ah-grid
      display: grid
      grid-template-columns: repeat(3, 1fr)
      gap: 16px
      margin-top: 6px

    .ah-tile
      padding: 20px 20px 22px
      border: 1px solid var(--hairline)
      border-radius: 14px
      background: var(--card-bg)
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s

      i
        font-size: 1.15rem
        color: var(--accent)
        text-shadow: 0 0 16px rgba(88, 225, 210, 0.55)

      h3
        margin: 10px 0 6px
        font-family: 'Outfit', sans-serif
        font-size: 1.05rem
        font-weight: 600
        letter-spacing: 0.03em
        color: var(--text-highlight-color)
        border-bottom: none

      p
        margin: 0
        font-family: 'Inter', sans-serif
        font-size: 0.9rem
        line-height: 1.7
        color: var(--light-grey)

      &:hover
        transform: translateY(-4px)
        border-color: rgba(88, 225, 210, 0.35)
        box-shadow: var(--void-glow)

    .ah-note
      margin-top: 20px
      padding: 10px 16px
      font-family: 'Inter', sans-serif
      font-style: italic
      font-size: 0.92rem
      color: var(--card-meta)
      border-left: 3px solid transparent
      border-image: var(--accent-grad) 1
      background: rgba(88, 225, 210, 0.05)
      border-radius: 0 10px 10px 0

@media (max-width: 768px)
  #page #article-container
    .ah
      flex-direction: column
      text-align: center
      padding: 26px 20px

      .ah-links
        justify-content: center

    .ah-focus .ah-grid
      grid-template-columns: 1fr
